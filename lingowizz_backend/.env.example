# 复制此文件为 .env 并填入实际配置（.env 不会被提交）

# 智谱 AI API Key（GLM-4-flash 对话 / GLM-4V-flash 图片理解）
ZHIPU_API_KEY=your_zhipu_api_key_here

# 对话所用模型（可选）
TUTOR_MODEL=glm-4-flash-250414

# 数据库：不填则使用本地 SQLite（lingowizz_backend/lingowizz.db）
# DATABASE_URL=postgresql://username:password@host:5432/database?sslmode=require

# Flask配置
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your_secret_key_here

# 服务器配置
HOST=0.0.0.0
PORT=5000
